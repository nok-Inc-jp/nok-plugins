diff --git a/plugin/hooks/write-guard.mjs b/plugin/hooks/write-guard.mjs
new file mode 100644
index 0000000..6ab2454
--- /dev/null
+++ b/plugin/hooks/write-guard.mjs
@@ -0,0 +1,26 @@
+#!/usr/bin/env node
+// PreToolUse フック。kousei-architect が docs/kousei.md の外に書こうとしたら止める。会話の本筋とほかのエージェントには何もしない。
+// 外の依存を使わない。読めない入力では止めない（止めるのは、はっきり分かるときだけ）。
+import { readFileSync } from "node:fs";
+
+let event;
+try {
+  event = JSON.parse(readFileSync(0, "utf8") || "{}");
+} catch {
+  process.exit(0);
+}
+const agent = String(event.agent_type || "").split(":").pop();
+if (agent !== "kousei-architect") process.exit(0);
+const input = event.tool_input && typeof event.tool_input === "object" ? event.tool_input : {};
+const p = String(input.file_path || input.notebook_path || "").replaceAll("\\", "/");
+const ok = /(^|\/)docs\/kousei\.md$/.test(p) && !p.split("/").includes("..");
+if (!ok) {
+  process.stdout.write(JSON.stringify({
+    hookSpecificOutput: {
+      hookEventName: "PreToolUse",
+      permissionDecision: "deny",
+      permissionDecisionReason: `kousei-architect が書けるのは docs/kousei.md だけです：${p || "（パスが無い）"}。ほかの直しの案は、返事に書いてください。`,
+    },
+  }));
+}
+process.exit(0);
