@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# 点検の前の原稿を 1 本、空の作業フォルダに置く（fude の共通の front-matter）。
+set -eu
+if [ -n "$(ls -A . 2>/dev/null)" ]; then echo "作業フォルダが空ではありません" >&2; exit 1; fi
+mkdir -p articles
+cat > articles/hello.md <<'EOF'
+---
+title: 業務アプリの権限表を先に作る
+slug: kengen-hyo-first
+date: 2026-11-20
+lang: ja
+targets: [zenn, qiita]
+topics: [design, security]
+emoji: 🔐
+type: tech
+---
+
+業務アプリを作るとき、画面より先に権限表を作ると、後で困らない。
+
+## 権限表とは
+
+役割ごとに、どのデータを見られて、何ができるかを表にした物。
+EOF
