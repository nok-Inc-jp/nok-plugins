--- /dev/null
+++ b/plugin/hooks/write-guard.mjs
@@ -0,0 +1,26 @@
+#!/usr/bin/env node
+// PreToolUse フック。gyomu-analyst が docs/gyomu-sheet.md の外に書こうとしたら止める。会話の本筋とほかのエージェントには何もしない。
+// 外の依存を使わない。読めない入力では止めない（止めるのは、はっきり分かるときだけ）。
+import { readFileSync } from "node:fs";
+
+let event;
+try {
+  event = JSON.parse(readFileSync(0, "utf8") || "{}");
+} catch {
+  process.exit(0);
+}
+const agent = String(event.agent_type || "").split(":").pop();
+if (agent !== "gyomu-analyst") process.exit(0);
+const input = event.tool_input && typeof event.tool_input === "object" ? event.tool_input : {};
+const p = String(input.file_path || input.notebook_path || "").replaceAll("\\", "/");
+const ok = /(^|\/)docs\/gyomu-sheet\.md$/.test(p) && !p.split("/").includes("..");
+if (!ok) {
+  process.stdout.write(JSON.stringify({
+    hookSpecificOutput: {
+      hookEventName: "PreToolUse",
+      permissionDecision: "deny",
+      permissionDecisionReason: `gyomu-analyst が書けるのは docs/gyomu-sheet.md だけです：${p || "（パスが無い）"}。ほかの直しの案は、返事に書いてください。`,
+    },
+  }));
+}
+process.exit(0);
