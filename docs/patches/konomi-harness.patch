+mkdir -p .konomi src
+cat > .konomi/screens.yaml <<'EOF'
+product:
+  kind: app
+screens:
+  - id: SCR-001
+    name: ログイン
+    slug: login
+EOF
+cat > src/Login.tsx <<'EOF'
+export function Login() {
+  return (
+    <div data-scr="SCR-001" style={{ padding: 8 }}>
+      <input placeholder="mail" />
+      <input placeholder="pass" type="password" />
+      <button style={{ background: "#f00", color: "#fff", fontSize: 10 }}>OK</button>
+    </div>
+  );
+}
+EOF
