+++ b/tests/test_guard.py
@@ -0,0 +1,36 @@
+"""report-guard.mjs（security-reviewer の書く先を絞るフック）のテスト。"""
+import json
+import pathlib
+import shutil
+import subprocess
+
+import pytest
+
+GUARD = pathlib.Path(__file__).resolve().parents[1] / "plugin" / "hooks" / "report-guard.mjs"
+
+
+def run(event) -> str:
+    if shutil.which("node") is None:
+        pytest.skip("node がありません")
+    text = event if isinstance(event, str) else json.dumps(event)
+    out = subprocess.run(["node", str(GUARD)], input=text, capture_output=True, text=True, timeout=20)
+    assert out.returncode == 0, out.stderr
+    return out.stdout
+
+
+@pytest.mark.parametrize("agent, path, denied", [
+    ("security-reviewer", "/w/docs/takumi-report.md", False),
+    ("takumi:security-reviewer", "/w/docs/takumi-report.md", False),
+    ("security-reviewer", "/w/src/app.js", True),
+    ("takumi:security-reviewer", "/w/docs/kousei.md", True),
+    ("security-reviewer", "/w/docs/../src/takumi-report.md", True),
+    ("", "/w/src/app.js", False),               # 会話の本筋は止めない
+    ("other", "/w/src/app.js", False),
+])
+def test_guard(agent, path, denied):
+    out = run({"agent_type": agent, "tool_name": "Write", "tool_input": {"file_path": path}})
+    assert (json.loads(out)["hookSpecificOutput"]["permissionDecision"] == "deny") if denied else out == ""
+
+
+def test_broken_input_passes():
+    assert run("{broken") == ""
