+#!/usr/bin/env bash
+# 認可の抜け（持ち主を確かめない削除）と、正しく確かめている管理者の処理を、空の作業フォルダに置く。
+set -eu
+if [ -n "$(ls -A . 2>/dev/null)" ]; then echo "作業フォルダが空ではありません" >&2; exit 1; fi
+mkdir -p src docs
+cat > src/orders.js <<'EOF'
+const express = require("express");
+const { auth, requireRole } = require("./auth");
+const db = require("./db");
+const r = express.Router();
+
+// 自分の注文の一覧
+r.get("/orders", auth, async (req, res) => {
+  res.json(await db.orders.find({ ownerId: req.user.id }));
+});
+
+// 注文を消す
+r.delete("/orders/:id", auth, async (req, res) => {
+  await db.orders.delete({ id: req.params.id });
+  res.sendStatus(204);
+});
+
+// 管理者だけが、全員の注文を書き出す
+r.get("/admin/orders.csv", auth, requireRole("admin"), async (req, res) => {
+  res.type("text/csv").send(await db.orders.toCsv());
+});
+
+module.exports = r;
+EOF
+cat > docs/gyomu-sheet.md <<'EOF'
+## 登場人物と権限
+| 役割 | 注文 |
+| --- | --- |
+| 社員 | 自分の注文を見る・消す（自） |
+| 管理者 | 全員の注文を見る・書き出す |
+EOF
