new file mode 100644
index 0000000..48f8e7a
--- /dev/null
+++ b/plugin/hooks/report-guard.mjs
@@ -0,0 +1,26 @@
+#!/usr/bin/env node
+// takumi の PreToolUse フック。security-reviewer が docs/takumi-report.md 以外に書こうとしたら止める。
+// 外の依存を使わない。読めない入力では止めない（止めるのは、はっきり分かるときだけ）。
+import { readFileSync } from "node:fs";
+
+let event;
+try {
+  event = JSON.parse(readFileSync(0, "utf8") || "{}");
+} catch {
+  process.exit(0);
+}
+const agent = String(event.agent_type || "").split(":").pop();
+if (agent !== "security-reviewer") process.exit(0);
+const input = event.tool_input && typeof event.tool_input === "object" ? event.tool_input : {};
+const p = String(input.file_path || input.notebook_path || "").replaceAll("\\", "/");
+const ok = /(^|\/)docs\/takumi-report\.md$/.test(p) && !p.split("/").includes("..");
+if (!ok) {
+  process.stdout.write(JSON.stringify({
+    hookSpecificOutput: {
+      hookEventName: "PreToolUse",
+      permissionDecision: "deny",
+      permissionDecisionReason: `security-reviewer が書けるのは docs/takumi-report.md だけです：${p || "（パスが無い）"}。直し方は報告に書いてください。`,
+    },
+  }));
+}
+process.exit(0);
