diff --git a/plugin/evals/distill-asks-cost-first/scaffold.sh b/plugin/evals/distill-asks-cost-first/scaffold.sh
new file mode 100755
index 0000000..989a074
--- /dev/null
+++ b/plugin/evals/distill-asks-cost-first/scaffold.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+# 採点できる短い答えの付いたタスク（足し算の文章題）を 80 件、空の作業フォルダに置く。
+set -eu
+if [ -n "$(ls -A . 2>/dev/null)" ]; then echo "作業フォルダが空ではありません" >&2; exit 1; fi
+for i in $(seq 1 80); do
+  a=$((i * 7 % 50 + 3)); b=$((i * 11 % 40 + 5))
+  printf '{"id": "t%03d", "prompt": "A shop had %d apples and received %d more. How many apples does it have now?", "answer": "%d"}\n' "$i" "$a" "$b" "$((a + b))"
+done > tasks.jsonl
